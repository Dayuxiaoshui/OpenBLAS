# Makefile for OMATCOPY Performance Test

CC = gcc
CFLAGS = -O3 -Wall -Wextra
RVV_FLAGS = -march=rv64gcv -mabi=lp64d

# 默认目标
all: test_omatcopy_perf test_omatcopy_perf_rvv

# 普通版本 (无RVV)
test_omatcopy_perf: test_omatcopy_perf.c
	$(CC) $(CFLAGS) -o $@ $< -lm

# RVV版本 (需要RISC-V工具链)
test_omatcopy_perf_rvv: test_omatcopy_perf.c
	riscv64-unknown-linux-gnu-gcc $(CFLAGS) $(RVV_FLAGS) -o $@ $< -lm

# 清理
clean:
	rm -f test_omatcopy_perf test_omatcopy_perf_rvv

# 帮助
help:
	@echo "Available targets:"
	@echo "  all                    - Build both versions"
	@echo "  test_omatcopy_perf     - Build scalar version"
	@echo "  test_omatcopy_perf_rvv - Build RVV version (requires RISC-V toolchain)"
	@echo "  clean                  - Remove built files"
	@echo "  help                   - Show this help"
	@echo ""
	@echo "Usage examples:"
	@echo "  ./test_omatcopy_perf 3000 4000 100"
	@echo "  ./test_omatcopy_perf_rvv 3000 4000 100"

.PHONY: all clean help






